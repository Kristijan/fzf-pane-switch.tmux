#!/usr/bin/env bash

printf '%s\n' "$*" >> "${TMUX_STUB_LOG}"

# Preserve tmux's command-list ordering for batched setup and cleanup calls.
arguments=()
for argument in "$@"; do
    if [[ "${argument}" == ';' ]]; then
        "$0" "${arguments[@]}" || exit
        arguments=()
    else
        arguments+=("${argument}")
    fi
done
if [[ ${#arguments[@]} -ne $# ]]; then
    "$0" "${arguments[@]}"
    exit
fi

if [[ "${1:-}" == '-V' ]]; then
    printf 'tmux %s\n' "${TMUX_STUB_VERSION:-3.8}"
    exit 0
fi

case "${1:-}" in
    if-shell)
        claim="${*: -1}"
        if [[ "${claim}" == *'@fzf_pane_switch_backdrop-owner '* ]]; then
            owner="${claim##*backdrop-owner }"
            printf '%s\n' "${TMUX_STUB_CLAIM_OWNER:-${owner:1:${#owner}-2}}" > "${TMUX_STUB_LOG}.owner"
        elif [[ "$*" == *"'display-message' '-p' 'installed'"* ]]; then
            printf 'installed\n'
        fi
        ;;
    show-option)
        option="${*: -1}"
        case "${option}" in
            @fzf_pane_switch_bind-key-mode) printf '%s\n' "${TMUX_STUB_BIND_KEY_MODE:-}" ;;
            @fzf_pane_switch_layout) printf '%s\n' "${TMUX_STUB_LAYOUT:-}" ;;
            @fzf_pane_switch_two-row-style) printf '%s\n' "${TMUX_STUB_STYLE:-}" ;;
            @fzf_pane_switch_row-1-format) printf '%s\n' "${TMUX_STUB_ROW_1:-}" ;;
            @fzf_pane_switch_row-2-format) printf '%s\n' "${TMUX_STUB_ROW_2:-}" ;;
            @fzf_pane_switch_separator) printf '%s\n' "${TMUX_STUB_SEPARATOR:-}" ;;
            @fzf_pane_switch_row-1-colours) printf '%s\n' "${TMUX_STUB_ROW_1_COLOURS:-}" ;;
            @fzf_pane_switch_row-2-colours) printf '%s\n' "${TMUX_STUB_ROW_2_COLOURS:-}" ;;
            @fzf_pane_switch_list-panes-colours) printf '%s\n' "${TMUX_STUB_LIST_COLOURS:-}" ;;
            @fzf_pane_switch_colour-separator) printf '%s\n' "${TMUX_STUB_SEPARATOR_COLOUR:-}" ;;
            @fzf_pane_switch_footer) printf '%s\n' "${TMUX_STUB_FOOTER:-}" ;;
            @fzf_pane_switch_jump-labels) printf '%s\n' "${TMUX_STUB_JUMP_LABELS:-}" ;;
            @fzf_pane_switch_refresh) printf '%s\n' "${TMUX_STUB_REFRESH:-}" ;;
            @fzf_pane_switch_preview-pane-start) printf '%s\n' "${TMUX_STUB_PREVIEW_PANE_START:-}" ;;
            @fzf_pane_switch_preview-pane-match) printf '%s\n' "${TMUX_STUB_PREVIEW_PANE_MATCH:-}" ;;
            @fzf_pane_switch_backdrop-dim) printf '%s\n' "${TMUX_STUB_BACKDROP_DIM:-}" ;;
            @fzf_pane_switch_backdrop-owner)
                if [[ -f "${TMUX_STUB_LOG}.owner" ]]; then
                    command cat "${TMUX_STUB_LOG}.owner"
                else
                    printf '%s\n' "${TMUX_STUB_BACKDROP_OWNER:-}"
                fi
                ;;
            @fzf_pane_switch_backdrop-was-local) printf '%s\n' "${TMUX_STUB_BACKDROP_WAS_LOCAL:-}" ;;
            @fzf_pane_switch_backdrop-previous-style) printf '%s\n' "${TMUX_STUB_BACKDROP_PREVIOUS_STYLE:-}" ;;
            @fzf_pane_switch_backdrop-installed-style) printf '%s\n' "${TMUX_STUB_BACKDROP_INSTALLED_STYLE:-}" ;;
            @fzf_pane_switch_backdrop-hook) printf '%s\n' "${TMUX_STUB_BACKDROP_HOOK:-}" ;;
            @fzf_pane_switch_tree-session-format) printf '%s\n' "${TMUX_STUB_TREE_SESSION:-}" ;;
            @fzf_pane_switch_tree-window-format) printf '%s\n' "${TMUX_STUB_TREE_WINDOW:-}" ;;
            @fzf_pane_switch_tree-pane-format) printf '%s\n' "${TMUX_STUB_TREE_PANE:-}" ;;
            @fzf_pane_switch_tree-session-colours) printf '%s\n' "${TMUX_STUB_TREE_SESSION_COLOURS:-}" ;;
            @fzf_pane_switch_tree-window-colours) printf '%s\n' "${TMUX_STUB_TREE_WINDOW_COLOURS:-}" ;;
            @fzf_pane_switch_tree-pane-colours) printf '%s\n' "${TMUX_STUB_TREE_PANE_COLOURS:-}" ;;
            window-style)
                if [[ " $* " == *' -A'* ]]; then
                    printf '%s\n' "${TMUX_STUB_WINDOW_STYLE_EFFECTIVE:-default}"
                else
                    printf '%s\n' "${TMUX_STUB_WINDOW_STYLE_LOCAL:-}"
                fi
                ;;
        esac
        ;;
    show-options)
        if [[ -n "${TMUX_STUB_SHOW_OPTIONS+x}" ]]; then
            printf '%s' "${TMUX_STUB_SHOW_OPTIONS}"
        else
            [[ -n "${TMUX_STUB_LAYOUT+x}" ]] && printf '@fzf_pane_switch_layout %s\n' "${TMUX_STUB_LAYOUT}"
            [[ -n "${TMUX_STUB_STYLE+x}" ]] && printf '@fzf_pane_switch_two-row-style %s\n' "${TMUX_STUB_STYLE}"
            [[ -n "${TMUX_STUB_ROW_1+x}" ]] && printf '@fzf_pane_switch_row-1-format %s\n' "${TMUX_STUB_ROW_1}"
            [[ -n "${TMUX_STUB_ROW_2+x}" ]] && printf '@fzf_pane_switch_row-2-format %s\n' "${TMUX_STUB_ROW_2}"
            [[ -n "${TMUX_STUB_SEPARATOR+x}" ]] && printf '@fzf_pane_switch_separator %s\n' "${TMUX_STUB_SEPARATOR}"
            [[ -n "${TMUX_STUB_ROW_1_COLOURS+x}" ]] && printf '@fzf_pane_switch_row-1-colours %s\n' "${TMUX_STUB_ROW_1_COLOURS}"
            [[ -n "${TMUX_STUB_ROW_2_COLOURS+x}" ]] && printf '@fzf_pane_switch_row-2-colours %s\n' "${TMUX_STUB_ROW_2_COLOURS}"
            [[ -n "${TMUX_STUB_LIST_COLOURS+x}" ]] && printf '@fzf_pane_switch_list-panes-colours %s\n' "${TMUX_STUB_LIST_COLOURS}"
            [[ -n "${TMUX_STUB_TREE_SESSION+x}" ]] && printf '@fzf_pane_switch_tree-session-format %s\n' "${TMUX_STUB_TREE_SESSION}"
            [[ -n "${TMUX_STUB_TREE_WINDOW+x}" ]] && printf '@fzf_pane_switch_tree-window-format %s\n' "${TMUX_STUB_TREE_WINDOW}"
            [[ -n "${TMUX_STUB_TREE_PANE+x}" ]] && printf '@fzf_pane_switch_tree-pane-format %s\n' "${TMUX_STUB_TREE_PANE}"
            [[ -n "${TMUX_STUB_TREE_SESSION_COLOURS+x}" ]] && printf '@fzf_pane_switch_tree-session-colours %s\n' "${TMUX_STUB_TREE_SESSION_COLOURS}"
            [[ -n "${TMUX_STUB_TREE_WINDOW_COLOURS+x}" ]] && printf '@fzf_pane_switch_tree-window-colours %s\n' "${TMUX_STUB_TREE_WINDOW_COLOURS}"
            [[ -n "${TMUX_STUB_TREE_PANE_COLOURS+x}" ]] && printf '@fzf_pane_switch_tree-pane-colours %s\n' "${TMUX_STUB_TREE_PANE_COLOURS}"
            [[ -n "${TMUX_STUB_BACKDROP_DIM+x}" ]] && printf '@fzf_pane_switch_backdrop-dim %s\n' "${TMUX_STUB_BACKDROP_DIM}"
        fi
        ;;
    list-sessions)
        if [[ -n "${TMUX_STUB_SESSIONS_OUTPUT:-}" ]]; then
            printf '%s' "${TMUX_STUB_SESSIONS_OUTPUT}"
        fi
        ;;
    list-windows)
        if [[ -n "${TMUX_STUB_WINDOWS_OUTPUT:-}" ]]; then
            printf '%s' "${TMUX_STUB_WINDOWS_OUTPUT}"
        fi
        ;;
    list-panes)
        if [[ "${TMUX_STUB_LIST_STATUS:-0}" -ne 0 ]]; then
            exit "${TMUX_STUB_LIST_STATUS}"
        fi
        if [[ "${TMUX_STUB_EXPAND_FORMAT:-false}" == 'true' ]]; then
            pane_format="${*: -1}"
            pane_format="${pane_format//'#{pane_id}'/'%1'}"
            pane_format="${pane_format//'#{pane_title}'/'Title'}"
            pane_format="${pane_format//'#{pane_current_command}'/'nvim'}"
            pane_format="${pane_format//'#{session_name}'/'work'}"
            pane_format="${pane_format//'#{window_name}'/'editor'}"
            pane_format="${pane_format//'#{s|/Users/[^/]*|~|:pane_current_path}'/'~/projects/fzf-pane-switch.tmux'}"
            printf '%s\n' "${pane_format}"
        elif [[ -n "${TMUX_STUB_LIST_OUTPUT:-}" ]]; then
            printf '%s' "${TMUX_STUB_LIST_OUTPUT}"
        else
            printf '%%1 work editor Title nvim\n'
        fi
        ;;
    capture-pane)
        if [[ "${TMUX_STUB_CAPTURE_STATUS:-0}" -ne 0 ]]; then
            exit "${TMUX_STUB_CAPTURE_STATUS}"
        fi
        printf '%s' "${TMUX_STUB_CAPTURE_OUTPUT:-}"
        ;;
    has-session)
        [[ "${*: -1}" == '%1' ]]
        ;;
    display-message)
        if [[ "${2:-}" == '-p' || "${*:1}" == *' -p '* ]]; then
            case "${*: -1}" in
                '#{window_id}') printf '%s\n' "${TMUX_STUB_WINDOW_ID:-@1}" ;;
                '#{session_id}') printf '%s\n' "${TMUX_STUB_SESSION_ID:-\$1}" ;;
            esac
            [[ "${TMUX_STUB_TARGET_EXISTS:-true}" == true ]]
        fi
        ;;
esac
